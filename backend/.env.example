# Supabase -> Connect (top bar) -> Session pooler connection string (port 5432).
# Plain postgresql:// URLs are fine; the app switches them to the psycopg driver.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JSON list of allowed frontend origins.
# JSON list or comma-separated URLs.
CORS_ORIGINS=["http://localhost:5173"]

# Booking rules use "today" in this timezone (the business is in Atlanta, GA).
BUSINESS_TIMEZONE=America/New_York

# Optional: Postgres for tests. Leave unset and tests start a throwaway embedded Postgres.
# TEST_DATABASE_URL=postgresql://...

# Supabase Auth (admin sign-in).
# Project URL: Project Settings -> Data API, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings -> API Keys. Server only; never put it in the frontend.
SUPABASE_SECRET_KEY=

# Public URL of the frontend; admin invite and password links point here.
FRONTEND_URL=http://localhost:5173

# Customer emails via Resend (https://resend.com). Without a key, emails are logged, not sent.
# RESEND_API_KEY=re_...
# Must use a domain verified in Resend to reach customers. The default onboarding sender only
# delivers to the Resend account owner's own address.
# EMAIL_FROM=The Red Popcorn Wagon <bookings@theredpopcornwagon.com>
# EMAIL_REPLY_TO=hello@theredpopcornwagon.com
# Send every email here instead of the real recipient while testing:
# EMAIL_TEST_RECIPIENT=you@example.com
