# Copy to .env.local (gitignored) and fill in.

# Leave unset in dev (Vite proxies /api to FastAPI). Set to the deployed API in production.
# VITE_API_BASE_URL=https://your-api.example.com/api/v1

# Supabase Auth for the admin panel (Project Settings -> Data API / API Keys).
# The publishable key (sb_publishable_...) is safe to expose in the browser.
# Never put the secret key (sb_secret_...) here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
